{% extends 'base.html.twig' %}
{% block title %}Nouveau Poste{% endblock %}
{% block page_title %}Structure Organisationnelle{% endblock %}
{% block body %}
<div class="card" style="max-width: 600px; margin: 0 auto;">
    <h3 style="margin-bottom: 2rem;">Créer un poste</h3>
    {{ form_start(form) }}
        <div class="form-group">{{ form_label(form.libelle) }}{{ form_widget(form.libelle) }}</div>
        <div class="form-group">{{ form_label(form.salaireBase, 'Salaire de base') }}{{ form_widget(form.salaireBase) }}</div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div class="form-group">{{ form_label(form.direction) }}{{ form_widget(form.direction) }}</div>
            <div class="form-group">{{ form_label(form.service) }}{{ form_widget(form.service) }}</div>
        </div>
        <div class="form-group">{{ form_label(form.description) }}{{ form_widget(form.description) }}</div>
        
        <div style="margin-top: 2rem; display: flex; gap: 1rem;">
            <button class="btn btn-primary" style="width: auto;">Enregistrer</button>
            <a href="{{ path('app_structure_index') }}" class="btn" style="background: var(--bg-main); width: auto;">Annuler</a>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
