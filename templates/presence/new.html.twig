{% extends 'base.html.twig' %}
{% block title %}Signaler Absence/Retard{% endblock %}
{% block page_title %}Présences RH{% endblock %}
{% block body %}
<div class="card" style="max-width: 600px; margin: 0 auto;">
    <h3 style="margin-bottom: 2rem;">Enregistrer un incident</h3>
    {{ form_start(form) }}
        <div class="form-group">{{ form_label(form.employe) }}{{ form_widget(form.employe) }}</div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div class="form-group">{{ form_label(form.typeEvenement, 'Type d\'événement') }}{{ form_widget(form.typeEvenement) }}</div>
            <div class="form-group">{{ form_label(form.dateEvenement, 'Date') }}{{ form_widget(form.dateEvenement) }}</div>
        </div>
        <div class="form-group">{{ form_label(form.justification) }}{{ form_widget(form.justification) }}</div>
        
        <div style="margin-top: 2rem; display: flex; gap: 1rem;">
            <button class="btn btn-primary" style="width: auto;">Enregistrer l'incident</button>
            <a href="{{ path('app_presence_index') }}" class="btn" style="background: var(--bg-main); width: auto;">Annuler</a>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
