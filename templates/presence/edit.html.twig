{% extends 'base.html.twig' %}

{% block title %}Modifier présence - Zanova GRH{% endblock %}
{% block page_title %}Édition de présence/absence{% endblock %}

{% block body %}
<div class="card" style="max-width: 600px; margin: 0 auto;">
    <h3 style="font-weight: 700; margin-bottom: 2rem;">Modifier l'enregistrement</h3>
    
    {{ form_start(form) }}
        {{ form_row(form.employe) }}
        {{ form_row(form.typeEvenement) }}
        {{ form_row(form.dateEvenement) }}
        {{ form_row(form.justification) }}
        
        <div style="margin-top: 2rem; display: flex; gap: 1rem;">
            <button class="btn btn-primary" style="width: auto; min-width: 150px;">
                <i class="fas fa-save" style="margin-right: 8px;"></i> Mettre à jour
            </button>
            <a href="{{ path('app_presence_index') }}" class="btn" style="background: var(--bg-main); width: auto;">Annuler</a>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
