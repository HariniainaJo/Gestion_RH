<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}GRH Zanova{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🏢</text></svg>">
        <script>
            (function () {
                try {
                    if (localStorage.getItem('zanova-theme') === 'dark') {
                        document.documentElement.setAttribute('data-theme', 'dark');
                    }
                } catch (e) {}
            })();
        </script>

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
            <!-- FullCalendar CSS -->
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/main.min.css">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
            <!-- FullCalendar JS -->
            <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>
        {% endblock %}
    </head>
    <body class="{% if not app.user %}login-page{% endif %}">
        <div class="bg-blobs"><span class="b1"></span><span class="b2"></span><span class="b3"></span><span class="b4"></span></div>

        <div class="{% if app.user %}app-layout{% endif %}">
            {% if app.user %}
                <aside class="sidebar">
                    <div class="brand-mark">Z</div>
                    <div class="brand-tag">ZANOVA<br>GRH</div>

                    <a href="{{ path('app_dashboard') }}" class="nav-link {{ app.request.attributes.get('_route') == 'app_dashboard' ? 'active' : '' }}">
                        <i class="fas fa-chart-pie"></i>
                        <span class="nav-text">Tableau<br>de bord</span>
                    </a>

                    <div class="nav-label">Organisation</div>
                    <a href="{{ path('app_structure_index') }}" class="nav-link {{ app.request.attributes.get('_route') == 'app_structure_index' ? 'active' : '' }}">
                        <i class="fas fa-sitemap"></i>
                        <span class="nav-text">Structure</span>
                    </a>
                    <a href="{{ path('app_groupe_index') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'app_groupe' ? 'active' : '' }}">
                        <i class="fas fa-users-rectangle"></i>
                        <span class="nav-text">Groupes</span>
                    </a>

                    <div class="nav-label">Personnel</div>
                    <a href="{{ path('app_employe_index') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'app_employe' ? 'active' : '' }}">
                        <i class="fas fa-users"></i>
                        <span class="nav-text">Employés</span>
                    </a>
                    <a href="{{ path('app_stagiaire_index') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'app_stagiaire' ? 'active' : '' }}">
                        <i class="fas fa-user-graduate"></i>
                        <span class="nav-text">Stagiaires</span>
                    </a>
                    <a href="{{ path('app_conge_index') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'app_conge' ? 'active' : '' }}">
                        <i class="fas fa-calendar-alt"></i>
                        <span class="nav-text">Congés</span>
                    </a>
                    <a href="{{ path('app_recrutement_index') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'app_recrutement' ? 'active' : '' }}">
                        <i class="fas fa-bullhorn"></i>
                        <span class="nav-text">Recrutement</span>
                    </a>
                    <a href="{{ path('app_presence_index') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'app_presence' ? 'active' : '' }}">
                        <i class="fas fa-user-clock"></i>
                        <span class="nav-text">Présences</span>
                    </a>
                    <a href="{{ path('app_planning') }}" class="nav-link {{ app.request.attributes.get('_route') == 'app_planning' ? 'active' : '' }}">
                        <i class="fas fa-calendar-day"></i>
                        <span class="nav-text">Planning</span>
                    </a>

                    {% if is_granted('FINANCE_MANAGE') %}
                    <div class="nav-label">Finance</div>
                    <a href="{{ path('app_finance_perf') }}" class="nav-link {{ app.request.attributes.get('_route') == 'app_finance_perf' ? 'active' : '' }}">
                        <i class="fas fa-bullseye"></i>
                        <span class="nav-text">KPI</span>
                    </a>
                    <a href="{{ path('app_finance_paie') }}" class="nav-link {{ app.request.attributes.get('_route') == 'app_finance_paie' ? 'active' : '' }}">
                        <i class="fas fa-file-invoice-dollar"></i>
                        <span class="nav-text">Paie</span>
                    </a>
                    <a href="{{ path('app_finance_avances') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'app_finance_avance' ? 'active' : '' }}">
                        <i class="fas fa-hand-holding-dollar"></i>
                        <span class="nav-text">Avances</span>
                    </a>
                    <a href="{{ path('app_cotisation_index') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'app_cotisation' ? 'active' : '' }}">
                        <i class="fas fa-scale-balanced"></i>
                        <span class="nav-text">Cotisations</span>
                    </a>
                    {% endif %}

                    {% if is_granted('LOGISTIQUE_MANAGE') %}
                    <div class="nav-sep"></div>
                    <div class="nav-label">Logistique</div>
                    <a href="{{ path('app_logistique_navettes') }}" class="nav-link {{ app.request.attributes.get('_route') == 'app_logistique_navettes' ? 'active' : '' }}">
                        <i class="fas fa-bus"></i>
                        <span class="nav-text">Navettes</span>
                    </a>
                    {% endif %}
                </aside>
            {% endif %}

            <div class="{% if app.user %}main-content{% endif %}">
                {% if app.user %}
                    <div class="topbar" data-controller="collapse">
                        <div class="tb-brand"><span class="dot"></span> Zanova GRH · Portail RH</div>

                        <div class="tb-actions">
                            <div class="date-pill">
                                <i class="far fa-calendar"></i>
                                {{ "now"|date("d M Y") }}
                            </div>

                            {% set notif = header_notifications() %}
                            <div class="notif-wrap" data-controller="dropdown notifications">
                                <button class="notif-btn" data-action="click->dropdown#toggle" aria-label="Notifications">
                                    <i class="far fa-bell"></i>
                                    {% if notif.count > 0 %}
                                        <span class="notif-badge" data-notifications-target="badge">{{ notif.count }}</span>
                                    {% endif %}
                                </button>
                                <div class="notif-dropdown" data-dropdown-target="menu">
                                    <div class="notif-head">
                                        <b>Notifications</b>
                                        <button data-action="click->notifications#markAllRead">Tout marquer comme lu</button>
                                    </div>
                                    {% for item in notif.items %}
                                        <div class="notif-item unread">
                                            <span class="notif-dot" style="background: {{ item.type == 'warning' ? '#E8B400' : (item.type == 'danger' ? '#E5484D' : (item.type == 'success' ? '#18A957' : '#3B82F6')) }}"></span>
                                            <div>
                                                <div class="notif-text">{{ item.text }}</div>
                                                <div class="notif-time">{{ item.time }}</div>
                                            </div>
                                        </div>
                                    {% else %}
                                        <div class="notif-empty">Rien à signaler pour le moment</div>
                                    {% endfor %}
                                </div>
                            </div>

                            <button class="collapse-btn" data-action="click->collapse#toggle" aria-label="Réduire ou agrandir la barre">
                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 10 5 5 5-5"/></svg>
                            </button>

                            <div class="profile-wrap" data-controller="dropdown theme">
                                <button class="profile-btn" data-action="click->dropdown#toggle">
                                    <div class="avatar">{{ app.user.username|first|upper }}</div>
                                    <span class="profile-name">{{ app.user.username }}</span>
                                    <svg class="chev" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                                </button>
                                <div class="profile-dropdown" data-dropdown-target="menu">
                                    <div class="pd-head">
                                        <div class="avatar" style="width:38px;height:38px">{{ app.user.username|first|upper }}</div>
                                        <div>
                                            <div class="pd-name">{{ app.user.username }}</div>
                                            <div class="pd-mail">{{ app.user.roles|first }}</div>
                                        </div>
                                    </div>

                                    <button class="pd-item">
                                        <i class="fas fa-user-pen"></i>
                                        Modifier le profil
                                    </button>

                                    <div class="pd-theme">
                                        <span class="pd-theme-label">Thème</span>
                                        <div class="theme-switch">
                                            <button data-theme-target="lightBtn" data-action="click->theme#setLight" aria-label="Thème clair"><i class="fas fa-sun"></i></button>
                                            <button data-theme-target="darkBtn" data-action="click->theme#setDark" aria-label="Thème sombre"><i class="fas fa-moon"></i></button>
                                        </div>
                                    </div>

                                    <div class="pd-sep"></div>
                                    <a href="{{ path('app_logout') }}" class="pd-item danger">
                                        <i class="fas fa-right-from-bracket"></i>
                                        Déconnexion
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}

                <main class="{% if app.user %}content{% endif %}">
                    {% if app.user %}
                        <div class="page-head">
                            <div>
                                <div class="page-title">{% block page_title %}Aperçu{% endblock %}</div>
                                <div class="page-sub">Bienvenue sur votre portail RH</div>
                            </div>
                        </div>

                        {% for label, messages in app.flashes %}
                            {% for message in messages %}
                                <div class="alert" style="background: {{ label == 'success' ? 'var(--green-soft)' : 'var(--red-soft)' }}; color: {{ label == 'success' ? 'var(--green-dark)' : 'var(--red-dark)' }}; border-color: transparent;">
                                    {{ message }}
                                </div>
                            {% endfor %}
                        {% endfor %}
                    {% endif %}

                    {% block body %}{% endblock %}
                </main>
            </div>
        </div>
    </body>
</html>
