{% extends 'base.html.twig' %}

{% block title %}Modifier Campagne - Zanova GRH{% endblock %}
{% block page_title %}Recrutement{% endblock %}

{% block body %}
<div class="card" style="max-width: 800px; margin: 0 auto;">
    <div style="margin-bottom: 2rem; display: flex; align-items: center; gap: 1rem;">
        <a href="{{ path('app_recrutement_index') }}" class="btn" style="background: var(--bg-main); width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h3 style="font-weight: 700;">Modifier la campagne : {{ recrutement.poste.libelle }}</h3>
    </div>

    {{ form_start(form) }}
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
            <div class="form-group">
                {{ form_label(form.poste) }}
                {{ form_widget(form.poste) }}
            </div>
            <div class="form-group">
                {{ form_label(form.statut) }}
                {{ form_widget(form.statut) }}
            </div>
            <div class="form-group">
                {{ form_label(form.dateDebut) }}
                {{ form_widget(form.dateDebut) }}
            </div>
            <div class="form-group">
                {{ form_label(form.dateFin) }}
                {{ form_widget(form.dateFin) }}
            </div>
            <div class="form-group" style="grid-column: span 2;">
                {{ form_label(form.suggestions) }}
                {{ form_widget(form.suggestions) }}
            </div>
        </div>

        <div style="margin-top: 2rem; display: flex; gap: 1rem;">
            <button class="btn btn-primary" style="width: auto; min-width: 200px;">
                <i class="fas fa-save" style="margin-right: 8px;"></i> Enregistrer les modifications
            </button>
            <a href="{{ path('app_recrutement_index') }}" class="btn" style="background: var(--bg-main); width: auto;">Annuler</a>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
