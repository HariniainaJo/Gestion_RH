{% extends 'base.html.twig' %}
{% block title %}Demande de Congé{% endblock %}
{% block page_title %}Congés{% endblock %}
{% block body %}
<div class="card" style="max-width: 600px; margin: 0 auto;">
    <h3 style="margin-bottom: 2rem;">Nouvelle demande de congé</h3>
    {{ form_start(form) }}
        <div class="form-group">{{ form_label(form.employe) }}{{ form_widget(form.employe) }}</div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div class="form-group">{{ form_label(form.dateDebut) }}{{ form_widget(form.dateDebut) }}</div>
            <div class="form-group">{{ form_label(form.dateFin) }}{{ form_widget(form.dateFin) }}</div>
        </div>
        <div class="form-group">{{ form_label(form.typeConge) }}{{ form_widget(form.typeConge) }}</div>
        <div class="form-group">{{ form_label(form.motif) }}{{ form_widget(form.motif) }}</div>
        
        <div style="margin-top: 2rem; display: flex; gap: 1rem;">
            <button class="btn btn-primary" style="width: auto;">Envoyer la demande</button>
            <a href="{{ path('app_conge_index') }}" class="btn" style="background: var(--bg-main); width: auto;">Annuler</a>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
