{% extends 'base.html.twig' %}

{% block title %}Liste des employés - Zanova GRH{% endblock %}
{% block page_title %}Gestion du personnel{% endblock %}

{% block body %}
    <!-- Barre de filtrage -->
    <div class="card" style="margin-bottom: 1.5rem;">
        <div style="display: flex; gap: 1.5rem; align-items: flex-end; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 250px;">
                <label style="display: block; font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 0.5rem;">Rechercher un employé</label>
                <div style="position: relative;">
                    <i class="fas fa-search" style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: var(--text-muted);"></i>
                    <input type="text" id="filterSearch" class="form-input" placeholder="Nom, email, poste..." style="padding-left: 2.75rem;">
                </div>
            </div>
            <div style="width: 200px;">
                <label style="display: block; font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 0.5rem;">Statut</label>
                <select id="filterStatus" class="form-input">
                    <option value="all">Tous les statuts</option>
                    <option value="Actif">Actif</option>
                    <option value="Inactif">Inactif</option>
                </select>
            </div>
        </div>
    </div>

    <div class="card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
            <h3 style="font-weight: 700;">Répertoire des collaborateurs</h3>
            <div style="display: flex; gap: 1rem;">
                <a href="{{ path('app_employe_export') }}" class="btn" style="background: #10b981; color: white; width: auto; padding: 0.6rem 1.25rem; font-size: 0.875rem;">
                    <i class="fas fa-file-excel" style="margin-right: 8px;"></i> Export Excel
                </a>
                <a href="{{ path('app_employe_import') }}" class="btn" style="background: var(--green); color: white; width: auto; padding: 0.6rem 1.25rem; font-size: 0.875rem;">
                    <i class="fas fa-file-import" style="margin-right: 8px;"></i> Importer
                </a>
                <a href="{{ path('app_employe_new') }}" class="btn btn-primary" style="width: auto; padding: 0.6rem 1.25rem; font-size: 0.875rem;">
                    <i class="fas fa-plus" style="margin-right: 8px;"></i> Nouvel employé
                </a>
            </div>
        </div>


    <div class="table-container">

        <table>
            <thead>
                <tr>
                    <th>Employé</th>
                    <th>Poste</th>
                    <th>Email</th>
                    <th>Contact</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for employe in employes %}
                    <tr>
                        <td>
                            <div style="display: flex; align-items: center; gap: 0.75rem;">
                                <div style="width: 40px; height: 40px; background: #f1f5f9; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: var(--text-muted); font-weight: 700;">
                                    {% if employe.photoProfil and not (employe.photoProfil matches '/\\.pdf$/i') %}
                                        <img src="{{ asset('uploads/' ~ employe.photoProfil) }}" alt="" style="width: 100%; height: 100%; border-radius: 10px; object-fit: cover;">
                                    {% else %}
                                        {{ (employe.nom|first|upper) ~ (employe.prenom|first|upper) }}
                                    {% endif %}

                                </div>
                                <div>
                                    <div style="font-weight: 600;">{{ employe.nom }} {{ employe.prenom }}</div>
                                    <div style="font-size: 0.75rem; color: var(--text-muted);">ID: #EMP-{{ employe.id }}</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div style="font-size: 0.875rem;">{{ employe.poste.libelle }}</div>
                            <div style="font-size: 0.75rem; color: var(--text-muted);">{{ employe.poste.service.nomService ?? employe.poste.direction.nomDirection }}</div>
                        </td>
                        <td>{{ employe.email }}</td>
                        <td>{{ employe.contact }}</td>
                        <td>
                            <span class="badge {{ employe.statut == 'Actif' ? 'badge-success' : 'badge-danger' }}">
                                {{ employe.statut }}
                            </span>
                        </td>
                        <td>
                            <div style="display: flex; gap: 0.5rem;">
                                <a href="{{ path('app_employe_show', {'id': employe.id}) }}" class="btn" style="background: var(--bg-main); padding: 0.5rem; width: 32px; height: 32px; border-radius: 8px;">
                                    <i class="far fa-eye" style="font-size: 0.75rem;"></i>
                                </a>
                                <a href="{{ path('app_employe_edit', {'id': employe.id}) }}" class="btn" style="background: var(--bg-main); padding: 0.5rem; width: 32px; height: 32px; border-radius: 8px;">
                                    <i class="far fa-edit" style="font-size: 0.75rem;"></i>
                                </a>

                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" style="text-align: center; padding: 3rem; color: var(--text-muted);">
                            Aucun employé trouvé dans la base de données.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
<script>
document.addEventListener('turbo:load', function() {
    const searchInput = document.getElementById('filterSearch');
    const statusSelect = document.getElementById('filterStatus');
    const tableRows = document.querySelectorAll('tbody tr:not(.no-results)');

    function filterTable() {
        const searchTerm = searchInput.value.toLowerCase();
        const selectedStatus = statusSelect.value;

        tableRows.forEach(row => {
            const text = row.innerText.toLowerCase();
            const statusBadge = row.querySelector('.badge');
            const status = statusBadge ? statusBadge.innerText.trim() : 'all';
            
            const matchesSearch = text.includes(searchTerm);
            const matchesStatus = (selectedStatus === 'all' || status === selectedStatus);

            if (matchesSearch && matchesStatus) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    if (searchInput) searchInput.addEventListener('input', filterTable);
    if (statusSelect) statusSelect.addEventListener('change', filterTable);
});
</script>
{% endblock %}

