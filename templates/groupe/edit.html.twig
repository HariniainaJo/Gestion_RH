{% extends 'base.html.twig' %}
{% block title %}Modifier le Groupe{% endblock %}
{% block page_title %}Organisation{% endblock %}
{% block body %}
<div class="card" style="max-width: 600px; margin: 0 auto;">
    <h3 style="margin-bottom: 2rem;">Modifier le groupe : {{ groupe.nomGroupe }}</h3>
    {{ form_start(form) }}
        <div class="form-group">{{ form_label(form.nomGroupe) }}{{ form_widget(form.nomGroupe) }}</div>
        <div class="form-group">{{ form_label(form.typeGroupe) }}{{ form_widget(form.typeGroupe) }}</div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div class="form-group">{{ form_label(form.dateDebut) }}{{ form_widget(form.dateDebut) }}</div>
            <div class="form-group">{{ form_label(form.dateFin) }}{{ form_widget(form.dateFin) }}</div>
        </div>
        
        <div style="margin-top: 2rem; display: flex; gap: 1rem;">
            <button class="btn btn-primary" style="width: auto;">Enregistrer les modifications</button>
            <a href="{{ path('app_groupe_show', {'id': groupe.id}) }}" class="btn" style="background: var(--bg-main); width: auto;">Annuler</a>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
