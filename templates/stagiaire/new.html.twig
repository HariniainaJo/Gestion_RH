{% extends 'base.html.twig' %}
{% block title %}Nouveau Stagiaire{% endblock %}
{% block page_title %}Stagiaires{% endblock %}
{% block body %}
<div class="card" style="max-width: 800px; margin: 0 auto; padding: 2rem;">
    <h3 style="font-weight: 700; margin-bottom: 2rem; color: var(--text-dark);">Nouveau dossier de stage</h3>
    
    {{ form_start(form) }}
        <div style="margin-bottom: 2.5rem;">
            <h4 style="font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted); margin-bottom: 1rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem;">Informations Personnelles</h4>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
                <div class="form-group">{{ form_label(form.nom) }}{{ form_widget(form.nom) }}</div>
                <div class="form-group">{{ form_label(form.prenom) }}{{ form_widget(form.prenom) }}</div>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
                <div class="form-group">{{ form_label(form.email) }}{{ form_widget(form.email) }}</div>
                <div class="form-group">{{ form_label(form.contact) }}{{ form_widget(form.contact) }}</div>
            </div>
        </div>

        <div style="margin-bottom: 2.5rem;">
            <h4 style="font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted); margin-bottom: 1rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem;">Formation & École</h4>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
                <div class="form-group">{{ form_label(form.etablissement, 'Établissement') }}{{ form_widget(form.etablissement) }}</div>
                <div class="form-group">{{ form_label(form.niveau, 'Niveau actuel') }}{{ form_widget(form.niveau) }}</div>
            </div>
        </div>

        <div style="margin-bottom: 2.5rem;">
            <h4 style="font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted); margin-bottom: 1rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem;">Détails du Stage</h4>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
               <div class="form-group">
                    {{ form_label(form.currentStage.typeStage, 'Type de stage') }}
                    {{ form_widget(form.currentStage.typeStage) }}
               </div>
               <div class="form-group">
                    {{ form_label(form.currentStage.encadreur, 'Encadreur') }}
                    {{ form_widget(form.currentStage.encadreur) }}
               </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
               <div class="form-group">
                    {{ form_label(form.currentStage.dateDebut, 'Date de début') }}
                    {{ form_widget(form.currentStage.dateDebut) }}
               </div>
               <div class="form-group">
                    {{ form_label(form.currentStage.dateFin, 'Date de fin') }}
                    {{ form_widget(form.currentStage.dateFin) }}
               </div>
            </div>

            <div class="form-group">
                {{ form_label(form.currentStage.sujet, 'Sujet / Thème') }}
                {{ form_widget(form.currentStage.sujet) }}
            </div>
        </div>
        
        <div style="margin-top: 3rem; display: flex; justify-content: flex-end; gap: 1rem; border-top: 1px solid var(--border-color); padding-top: 1.5rem;">
            <a href="{{ path('app_stagiaire_index') }}" class="btn" style="background: white; border: 1px solid var(--border-color); color: var(--text-muted);">Annuler</a>
            <button class="btn btn-primary" style="padding: 0.75rem 2rem; box-shadow: 0 4px 6px -1px rgba(24, 169, 87, 0.35);">Enregistrer le stagiaire</button>
        </div>
    {{ form_end(form) }}
</div>

{% endblock %}
