{% extends 'base.html.twig' %}
{% block title %}Modifier Stagiaire{% endblock %}
{% block page_title %}Édition Stagiaire{% endblock %}
{% block body %}
<div class="card" style="max-width: 600px; margin: 0 auto;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
        <h3 style="font-weight: 700;">Modifier : {{ stagiaire.nom }} {{ stagiaire.prenom }}</h3>
        
        <form method="post" action="{{ path('app_stagiaire_delete', {'id': stagiaire.id}) }}" onsubmit="return confirm('Supprimer ce stagiaire ?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ stagiaire.id) }}">
            <button class="btn" style="background: #fee2e2; color: #991b1b; padding: 0.5rem 1rem;">
                <i class="fas fa-trash-alt"></i>
            </button>
        </form>
    </div>
    
    {{ form_start(form) }}
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div class="form-group">{{ form_label(form.nom) }}{{ form_widget(form.nom) }}</div>
            <div class="form-group">{{ form_label(form.prenom) }}{{ form_widget(form.prenom) }}</div>
        </div>
        <div class="form-group">{{ form_label(form.email) }}{{ form_widget(form.email) }}</div>
        <div class="form-group">{{ form_label(form.contact) }}{{ form_widget(form.contact) }}</div>
        <div class="form-group">{{ form_label(form.etablissement) }}{{ form_widget(form.etablissement) }}</div>
        <div class="form-group">{{ form_label(form.niveau) }}{{ form_widget(form.niveau) }}</div>
        
        <div style="margin-top: 1.5rem; padding: 1.5rem; background: var(--bg-main); border-radius: 12px; border: 1px dashed var(--border-color);">
            <h4 style="font-size: 0.875rem; font-weight: 700; margin-bottom: 1rem; color: var(--primary);">INFOS SUR LE STAGE</h4>
            {{ form_widget(form.currentStage) }}
        </div>
        
        <div style="margin-top: 2rem; display: flex; gap: 1rem;">
            <button class="btn btn-primary" style="width: auto; min-width: 150px;">
                <i class="fas fa-save" style="margin-right: 8px;"></i> Mettre à jour
            </button>
            <a href="{{ path('app_stagiaire_index') }}" class="btn" style="background: var(--bg-main); width: auto;">Annuler</a>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
