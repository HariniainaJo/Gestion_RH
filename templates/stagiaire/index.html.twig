{% extends 'base.html.twig' %}

{% block title %}Gestion des stagiaires - Zanova GRH{% endblock %}
{% block page_title %}Stagiaires{% endblock %}

{% block body %}
    <!-- Barre de filtrage -->
    <div class="card" style="margin-bottom: 1.5rem;">
        <div style="display: flex; gap: 1.5rem; align-items: flex-end; flex-wrap: wrap;">
            <div style="flex: 1;">
                <label style="display: block; font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 0.5rem;">Rechercher un stagiaire</label>
                <div style="position: relative;">
                    <i class="fas fa-search" style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: var(--text-muted);"></i>
                    <input type="text" id="filterSearch" class="form-input" placeholder="Nom, établissement, niveau..." style="padding-left: 2.75rem;">
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
            <h3 style="font-weight: 700;">Liste des stagiaires</h3>
            <a href="{{ path('app_stagiaire_new') }}" class="btn btn-primary" style="width: auto; padding: 0.6rem 1.25rem;">
                <i class="fas fa-plus" style="margin-right: 8px;"></i> Nouveau stagiaire
            </a>
        </div>


    <div class="table-container">

        <table>
            <thead>
                <tr>
                    <th>Stagiaire</th>
                    <th>Établissement</th>
                    <th>Niveau</th>
                    <th>Email</th>
                    <th>Contact</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for stagiaire in stagiaires %}
                    <tr>
                        <td style="font-weight: 600;">{{ stagiaire.nom }} {{ stagiaire.prenom }}</td>
                        <td>{{ stagiaire.etablissement }}</td>
                        <td>{{ stagiaire.niveau }}</td>
                        <td>{{ stagiaire.email }}</td>
                        <td>{{ stagiaire.contact }}</td>
                        <td>
                            <div style="display: flex; gap: 0.5rem;">
                                <a href="{{ path('app_stagiaire_edit', {'id': stagiaire.id}) }}" class="btn" style="background: var(--bg-main); padding: 0.5rem; width: 32px; height: 32px; border-radius: 8px;">
                                    <i class="far fa-edit" style="font-size: 0.75rem;"></i>
                                </a>
                            </div>
                        </td>

                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" style="text-align: center; padding: 3rem; color: var(--text-muted);">
                            Aucun stagiaire enregistré.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
<script>
document.addEventListener('turbo:load', function() {
    const searchInput = document.getElementById('filterSearch');
    const tableRows = document.querySelectorAll('tbody tr:not(.no-results)');

    function filterTable() {
        const searchTerm = searchInput.value.toLowerCase();

        tableRows.forEach(row => {
            const text = row.innerText.toLowerCase();
            if (text.includes(searchTerm)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    if (searchInput) searchInput.addEventListener('input', filterTable);
});
</script>
{% endblock %}

