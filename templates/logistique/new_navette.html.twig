{% extends 'base.html.twig' %}
{% block title %}Nouvelle Navette{% endblock %}
{% block page_title %}Logistique{% endblock %}
{% block body %}
<div class="card" style="max-width: 500px; margin: 0 auto;">
    <h3 style="margin-bottom: 2rem;">Enregistrer une navette</h3>
    {{ form_start(form) }}
        <div class="form-group">{{ form_label(form.codeNavette) }}{{ form_widget(form.codeNavette) }}</div>
        <div class="form-group">{{ form_label(form.axe) }}{{ form_widget(form.axe) }}</div>
        <div class="form-group">{{ form_label(form.capacite) }}{{ form_widget(form.capacite) }}</div>
        
        <div style="margin-top: 2rem; display: flex; gap: 1rem;">
            <button class="btn btn-primary" style="width: auto;">Enregistrer</button>
            <a href="{{ path('app_logistique_navettes') }}" class="btn" style="background: var(--bg-main); width: auto;">Annuler</a>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
